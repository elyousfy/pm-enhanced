<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<!-- Mihrab style: the logo arch frames a centred serif countdown. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF000000"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade"
        android:tint="#FF0D0D0D"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow"
        android:tint="#FF777777"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="-8dp"
        android:alpha="0.1"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pm_logo"
        android:tint="#FFF2F2F2"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/widget_part_pill" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/source_serif_600"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/dhuhr"
            android:textColor="#FFF5F5F5"
            android:textSize="17sp" />

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/source_serif_400"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFF2F2F2"
            android:textDirection="ltr"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/public_sans_400"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFA3A3A3"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_pin"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_pin" />

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/public_sans_500"
                android:maxLines="1"
                android:textColor="#FFA3A3A3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
