<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<!-- Status band style: auto-silence state as a full-width band at the bottom. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF000000"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade"
        android:tint="#FF0D0D0D"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow"
        android:tint="#FF777777"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-18dp"
        android:layout_marginEnd="-26dp"
        android:alpha="0.1"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pm_logo"
        android:tint="#FFF2F2F2"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/public_sans_600"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#FFA3A3A3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/public_sans_600"
                android:maxLines="1"
                android:text="@string/dhuhr"
                android:textColor="#FFF5F5F5"
                android:textSize="18sp" />

            <Chronometer
                android:id="@+id/widget_countdown"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:autoSizeMaxTextSize="36sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/public_sans_600"
                android:fontFeatureSettings="tnum"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="#FFF5F5F5"
                android:textDirection="ltr"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_pin"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_pin" />
    
                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/public_sans_500"
                    android:maxLines="1"
                    android:textColor="#FFA3A3A3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_band_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/widget_band_content"
                android:layout_alignBottom="@+id/widget_band_content"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_band" />

            <ImageView
                android:id="@+id/widget_band_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_band_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="11dp"
                android:paddingEnd="16dp"
                android:paddingBottom="11dp">

                <ImageView
                    android:id="@+id/widget_band_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_on" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/public_sans_600"
                    android:maxLines="1"
                    android:textColor="#FFF5F5F5"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
