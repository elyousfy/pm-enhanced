<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<!-- Classic style: brand header, "Until Dhuhr", big countdown, city and Hijri date, logo watermark. -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF000000"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade"
        android:tint="#FF0D0D0D"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow"
        android:tint="#FF777777"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-46dp"
        android:layout_marginBottom="-34dp"
        android:alpha="0.1"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pm_logo"
        android:tint="#FFF2F2F2"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pm_logo" />

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/public_sans_600"
                android:maxLines="1"
                android:text="@string/widget_brand"
                android:textColor="#FFA3A3A3"
                android:textSize="12sp" />

            <include layout="@layout/widget_part_pill" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/public_sans_500"
            android:maxLines="1"
            android:text="@string/dhuhr"
            android:textColor="#FFF5F5F5"
            android:textSize="16sp" />

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:autoSizeMaxTextSize="38sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/public_sans_500"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:textColor="#FFF2F2F2"
            android:textDirection="ltr"
            android:textSize="38sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_pin"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_pin" />

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="@font/public_sans_500"
                android:maxLines="1"
                android:textColor="#FFA3A3A3"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/public_sans_400"
            android:maxLines="1"
            android:textColor="#FFA3A3A3"
            android:textSize="10.5sp" />
    </LinearLayout>
</FrameLayout>
