<?xml version="1.0" encoding="utf-8"?>
<!-- Ring style: the full track; PrayerWidget draws the progress arc on top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <!-- Explicit transparent fill: a tinted shape without one fills solid. -->
    <solid android:color="#00000000" />
    <stroke android:width="5dp" android:color="#FFFFFFFF" />
    <padding android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp" />
</shape>
